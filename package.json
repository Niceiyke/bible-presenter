{
  "name": "wordlyte",
  "private": true,
  "version": "2.1.1",
  "type": "module",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --pool=forks",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "check:p0": "npm run check:secrets && npm test -- --run && npm run build",
    "prepare:ndi": "powershell -ExecutionPolicy Bypass -File scripts/prepare-ndi.ps1",
    "check:ndi": "npm run prepare:ndi && cargo check --manifest-path src-tauri/Cargo.toml --features ndi",
    "build:ndi": "npm run prepare:ndi && tauri build --features ndi --config src-tauri/tauri.ndi.conf.json",
    "ai:eval": "cargo run --manifest-path tools/ai-eval/Cargo.toml -- evaluation/ai-scripture/synthetic.jsonl",
    "tauri": "tauri",
    "convert-hymns": "node scripts/convert-gospel-hymns.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tiptap/extension-color": "^3.20.0",
    "@tiptap/extension-font-family": "^3.29.2",
    "@tiptap/extension-text-align": "^3.20.0",
    "@tiptap/extension-text-style": "^3.20.0",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/html": "^3.29.2",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "framer-motion": "^12.34.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "wavesurfer.js": "^7.12.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.24",
    "happy-dom": "^20.11.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
