{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Wordlyte",
  "windows": ["main", "stage", "studio"],
  "permissions": [
    "core:default",
    "dialog:default",
    "shell:allow-open",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:webview:allow-internal-toggle-devtools"
  ]
}
