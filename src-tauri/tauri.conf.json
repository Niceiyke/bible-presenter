{
  "productName": "Wordlyte",
  "version": "2.0.2",
  "identifier": "io.wordlyte.app",
  "build": {
    "beforeDevCommand": {
      "cwd": "../",
      "script": "node scripts/copy-engine-binary.mjs --bootstrap && npm run dev"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "cwd": "../",
      "script": "node scripts/copy-engine-binary.mjs --bootstrap && npm run build"
    },
    "beforeBundleCommand": {
      "cwd": "../",
      "script": "node scripts/copy-engine-binary.mjs"
    },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wordlyte - Operator",
        "width": 1200,
        "height": 800,
        "label": "main",
        "create": false
      },
      {
        "title": "Wordlyte - Design Hub",
        "label": "design",
        "width": 1440,
        "height": 900,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": false,
        "resizable": true,
        "create": false
      },
      {
        "title": "Wordlyte - Audio Studio",
        "label": "studio",
        "width": 1440,
        "height": 900,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": false,
        "resizable": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' blob:; connect-src 'self' asset: http://asset.localhost https://asset.localhost https: http:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: asset: http://asset.localhost https://asset.localhost data:; media-src 'self' blob: asset: http://asset.localhost https://asset.localhost;",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bible_data/hymns.json": "bible_data/hymns.json",
      "../dist": "dist",
      "binaries/wordlyte-engine.exe": "wordlyte-engine.exe",
      "binaries/dll/*.dll": "."
    },
    "windows": {
      "nsis": {
        "languages": [
          "English"
        ],
        "compression": "zlib",
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
