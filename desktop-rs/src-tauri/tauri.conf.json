{
  "productName": "Wordlyte",
  "version": "1.3.0",
  "identifier": "io.wordlyte.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wordlyte - Operator",
        "width": 1200,
        "height": 800,
        "label": "main"
      },
      {
        "title": "Wordlyte - Output",
        "label": "output",
        "width": 1920,
        "height": 1080,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "title": "Wordlyte - Stage",
        "label": "stage",
        "width": 1280,
        "height": 720,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true
      },
      {
        "title": "Wordlyte - Design Hub",
        "label": "design",
        "width": 1440,
        "height": 900,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": false,
        "resizable": true
      },
      {
        "title": "Wordlyte - Audio Studio",
        "label": "studio",
        "width": 1440,
        "height": 900,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: wordlyte-stream:; connect-src 'self' wordlyte-stream: asset: http://asset.localhost https://asset.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: wordlyte-stream: asset: http://asset.localhost https://asset.localhost data:; media-src 'self' blob: asset: http://asset.localhost https://asset.localhost;",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "bible_data/hymns.json",
      "bin/gstreamer/**/*"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English"
        ],
        "compression": "zlib",
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
