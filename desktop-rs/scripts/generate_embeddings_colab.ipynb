   "source": [
    "# Bible Presenter — Stacked Embeddings Generator (USearch)\n",
    "\n",
    "This notebook generates `all_versions_embeddings.usearch` for the Bible Presenter app using high-accuracy verified text.\n",
    "\n",
    "**Before running:**\n",
    "1. In the top menu go to **Runtime → Change runtime type → T4 GPU**\n",
    "2. Run **Cell 1 & 2** to install dependencies.\n",
    "3. Run **Cell 3** and upload your high-accuracy `wordlyte_bible.db` file.\n",
    "4. Run **Cell 4 & 5** to generate and download the index.\n",
    "\n",
    "Versions embedded: `KJV, ASV, WEB, AMP, NIV, NKJV`  \n",
    "Model: `BAAI/bge-small-en-v1.5`  \n",
    "Expected time with T4 GPU: ~5–10 minutes"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 1: Check GPU ────────────────────────────────────────────────────────\n",
    "import subprocess\n",
    "result = subprocess.run(['nvidia-smi', '--query-gpu=name,memory.total', '--format=csv,noheader'],\n",
    "                        capture_output=True, text=True)\n",
    "if result.returncode == 0:\n",
    "    print('GPU detected:', result.stdout.strip())\n",
    "else:\n",
    "    print('WARNING: No GPU detected. Go to Runtime → Change runtime type → T4 GPU')\n",
    "    print('Continuing on CPU will take ~1-2 hours instead of ~5 minutes.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 2: Install dependencies ─────────────────────────────────────────────\n",
    "!pip install -q sentence-transformers numpy usearch"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 3: Upload wordlyte_bible.db ──────────────────────────────────────────\n",
    "from google.colab import files\n",
    "import os\n",
    "\n",
    "DB_PATH = 'wordlyte_bible.db'\n",
    "\n",
    "if not os.path.exists(DB_PATH):\n",
    "    print('Please upload your wordlyte_bible.db (the high-accuracy one):')\n",
    "    uploaded = files.upload()\n",
    "    for name in uploaded.keys():\n",
    "        if name != DB_PATH:\n",
    "            os.rename(name, DB_PATH)\n",
    "    print(f'Upload complete. Size: {os.path.getsize(DB_PATH) / 1e6:.1f} MB')\n",
    "else:\n",
    "    print(f'Already exists. Size: {os.path.getsize(DB_PATH) / 1e6:.1f} MB')\n",
    "\n",
    "# Quick sanity check\n",
    "import sqlite3\n",
    "db = sqlite3.connect(DB_PATH)\n",
    "versions = [r[0] for r in db.execute(\"SELECT DISTINCT version FROM wordlyte_bible WHERE language='EN' ORDER BY version\").fetchall()]\n",
    "print('Available EN versions in DB:', versions)\n",
    "db.close()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 4: Generate stacked embeddings & Usearch index ──────────────────────\n",
    "import sqlite3\n",
    "import numpy as np\n",
    "from sentence_transformers import SentenceTransformer\n",
    "from usearch.index import Index\n",
    "\n",
    "# Versions to embed — must match EMBEDDED_VERSIONS in src-tauri/src/store/mod.rs\n",
    "VERSIONS = ['KJV', 'ASV', 'WEB', 'AMP', 'NIV', 'NKJV']\n",
    "OUT_USEARCH  = 'all_versions_embeddings.usearch'\n",
    "OUT_IDX  = 'verse_index.json'\n",
    "\n",
    "MODEL_NAME = 'BAAI/bge-small-en-v1.5'\n",
    "print(f'Loading model {MODEL_NAME}...')\n",
    "model = SentenceTransformer(MODEL_NAME)\n",
    "print('Model ready.')\n",
    "\n",
    "db = sqlite3.connect(DB_PATH)\n",
    "\n",
    "available = {r[0] for r in db.execute(\"SELECT DISTINCT version FROM wordlyte_bible WHERE language='EN'\")}\n",
    "versions_to_use = [v for v in VERSIONS if v in available]\n",
    "missing = [v for v in VERSIONS if v not in available]\n",
    "if missing:\n",
    "    print(f'WARNING: versions not in DB, skipping: {missing}')\n",
    "print(f'Embedding versions: {versions_to_use}')\n",
    "\n",
    "all_embeddings = []\n",
    "verse_index    = []\n",
    "\n",
    "for version in versions_to_use:\n",
    "    print(f'\\n── {version} ──')\n",
    "    # Note: Use ORDER BY book, chapter, verse to ensure consistent stacking order\n",
    "    rows = db.execute(\n",
    "        'SELECT title, chapter, verse, text FROM wordlyte_bible '\n",
    "        'WHERE version = ? AND language = ? ORDER BY book, chapter, verse',\n",
    "        (version, 'EN')\n",
    "    ).fetchall()\n",
    "    print(f'  {len(rows)} verses')\n",
    "\n",
    "    texts = [r[3] for r in rows]\n",
    "    embs  = model.encode(\n",
    "        texts,\n",
    "        normalize_embeddings=True,\n",
    "        batch_size=512,\n",
    "        show_progress_bar=True,\n",
    "        convert_to_numpy=True,\n",
    "        device='cuda' if __import__('torch').cuda.is_available() else 'cpu',\n",
    "    )\n",
    "    all_embeddings.append(embs.astype(np.float32))\n",
    "    for r in rows:\n",
    "        verse_index.append({'book': r[0], 'chapter': int(r[1]), 'verse': int(r[2]), 'version': version})\n",
    "\n",
    "db.close()\n",
    "\n",
    "stacked = np.vstack(all_embeddings)\n",
    "print(f'\\nStacked shape: {stacked.shape}')\n",
    "\n",
    "print('Building USearch Index...')\n",
    "index = Index(ndim=384, metric=\"cos\", dtype=\"f32\")\n",
    "index.add(np.arange(len(stacked)), stacked)\n",
    "print(f'Saving USearch Index → {OUT_USEARCH}')\n",
    "index.save(str(OUT_USEARCH))\n",
    "\n",
    "import json\n",
    "with open(OUT_IDX, 'w') as f:\n",
    "    json.dump(verse_index, f, separators=(',', ':'))\n",
    "print(f'Saved → {OUT_IDX}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 5: Download the files ────────────────────────────────────────────────\n",
    "from google.colab import files\n",
    "import os\n",
    "\n",
    "usearch_size = os.path.getsize('all_versions_embeddings.usearch') / 1e6\n",
    "idx_size = os.path.getsize('verse_index.json') / 1e6\n",
    "print(f'all_versions_embeddings.usearch  {usearch_size:.1f} MB')\n",
    "print(f'verse_index.json                 {idx_size:.1f} MB')\n",
    "print('\\nStarting download...')\n",
    "\n",
    "files.download('all_versions_embeddings.usearch')\n",
    "files.download('verse_index.json')"
   ]
  }\n",
  {
