node_modules/
dist/
target/
src-tauri/target/
.old-desktop/

# Large model files — must be provided separately (not stored in git)
src-tauri/models/*.bin
src-tauri/models/*.onnx

# Large data files — must be provided separately (not stored in git)
src-tauri/bible_data/*.db
src-tauri/bible_data/*.npy
# Generated semantic index fixture for the manual paraphrase quality probe
src-tauri/bible_data/bible-semantic-bge-v1.index

# Bundled media binaries — fetched via scripts/fetch-ffmpeg.ps1 (not committed)
src-tauri/binaries/*.exe
# NDI runtime is copied from the developer's EULA-accepted SDK installation.
src-tauri/binaries/ndi/*.dll

# Playwright artifacts
test-results/
playwright-report/

# DB-only Bible data release asset (uploaded to the GitHub release, not committed)
/wordlyte_bible.zip

# tokenizer.json is small (~2MB) and is committed
!src-tauri/models/tokenizer.json

# Stray build/cargo log artifacts
src-tauri/*.log
src-tauri/*.err.log
src-tauri/check_*.log
.env
evaluation/ai-scripture/private/

# Cloudflare Workers secrets (ADMIN_TOKEN lives here) and local build/dev artifacts
.dev.vars
.wrangler/

# License signing keypair — NEVER commit the private half. Only the public key
# (embedded in src-tauri/src/license.rs) is checked in.
workers/license/.license-sign-private.jwk
